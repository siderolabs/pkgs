tegra-drm: struct drm_atomic_state is drm_atomic_commit in Linux 7.2

Linux 7.2 renamed struct drm_atomic_state to struct drm_atomic_commit
(the helpers moved to drm_atomic_commit_*). tegra-drm is built headless
(see pkg.yaml), so only drm.c needs the new name; no drm_atomic_state_*
helper is called.

diff --git a/drivers/gpu/drm/tegra/drm.c b/drivers/gpu/drm/tegra/drm.c
index a9ebf72..9e766f1 100644
--- a/drivers/gpu/drm/tegra/drm.c
+++ b/drivers/gpu/drm/tegra/drm.c
@@ -58,7 +58,7 @@
 #define CDMA_GATHER_FETCHES_MAX_NB 16383
 
 static int tegra_atomic_check(struct drm_device *drm,
-			      struct drm_atomic_state *state)
+			      struct drm_atomic_commit *state)
 {
 	int err;
 
@@ -81,7 +81,7 @@ static const struct drm_mode_config_funcs tegra_drm_mode_config_funcs = {
 
 #ifdef CONFIG_DRM_TEGRA_HAVE_DISPLAY
 static void tegra_atomic_post_commit(struct drm_device *drm,
-				     struct drm_atomic_state *old_state)
+				     struct drm_atomic_commit *old_state)
 {
 	struct drm_crtc_state *old_crtc_state __maybe_unused;
 	struct drm_crtc *crtc;
@@ -91,7 +91,7 @@ static void tegra_atomic_post_commit(struct drm_device *drm,
 		tegra_crtc_atomic_post_commit(crtc, old_state);
 }
 
-static void tegra_atomic_commit_tail(struct drm_atomic_state *old_state)
+static void tegra_atomic_commit_tail(struct drm_atomic_commit *old_state)
 {
 	struct drm_device *drm = old_state->dev;
 	struct tegra_drm *tegra = drm->dev_private;
