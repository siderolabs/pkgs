nvgpu: use GPIO descriptors for PCI power controls

Replace the removed OF integer-GPIO interface with firmware-node GPIO
lookups. Keep GPIOD_ASIS and raw values to preserve the existing physical
levels and direction handling, including active-low firmware flags.

diff --git a/drivers/gpu/nvgpu/os/linux/pci_power.c b/drivers/gpu/nvgpu/os/linux/pci_power.c
index 6406eb3..7f9032b 100644
--- a/drivers/gpu/nvgpu/os/linux/pci_power.c
+++ b/drivers/gpu/nvgpu/os/linux/pci_power.c
@@ -5,7 +5,7 @@
 #include <linux/list.h>
 #include <linux/pci.h>
 #include <linux/platform_device.h>
-#include <linux/of_gpio.h>
+#include <linux/of.h>
 #include <linux/gpio/consumer.h>
 #include <linux/ktime.h>
 #include <linux/debugfs.h>
@@ -170,19 +170,19 @@ static void nvgpu_dump_pci_gpios(struct nvgpu_pci_gpios *pgpios, const char *f)
 	pr_debug("nvgpu gpio status in %s:\n", f);
 
 	for (i = 0; i < PCI_GPIO_MAX; i++) {
-		if (pgpios->gpios[i] == 0) {
+		if (pgpios->gpios[i] == NULL) {
 			pr_debug("%d. %-25s: gpio not requested\n",
 				 i, nvgpu_pci_gpio_name(i));
 			continue;
 		}
 
-		gd = gpio_to_desc(pgpios->gpios[i]);
+		gd = pgpios->gpios[i];
 		if (gd) {
 			is_in = gpiod_get_direction(gd);
-			val = gpiod_get_value_cansleep(gd);
+			val = gpiod_get_raw_value_cansleep(gd);
 
 			pr_debug("%d. %-25s gpio-%-3d dir=%s val=%s\n",
-				 i, nvgpu_pci_gpio_name(i), pgpios->gpios[i],
+				 i, nvgpu_pci_gpio_name(i), gpiod_hwgpio(gd),
 				 is_in ? "in " : "out",
 				 val >= 0 ? (val != 0 ? "hi" : "lo") : "?  ");
 
@@ -199,8 +199,8 @@ static void nvgpu_free_pci_gpios(struct nvgpu_pci_gpios *pgpios)
 
 	for (i = 0; i < PCI_GPIO_MAX; i++) {
 		if (pgpios->gpios[i]) {
-			gpio_free(pgpios->gpios[i]);
-			pgpios->gpios[i] = 0;
+			gpiod_put(pgpios->gpios[i]);
