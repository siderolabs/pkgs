 		}
 	}
 }
@@ -208,7 +208,8 @@ static void nvgpu_free_pci_gpios(struct nvgpu_pci_gpios *pgpios)
 static int nvgpu_request_pci_gpios(struct nvgpu_pci_gpios *pgpios)
 {
 	struct device_node *np;
-	int i, ret, gpio;
+	struct gpio_desc *gpio;
+	int i, ret;
 
 	if (pgpios->gpios[0])
 		return 0;
@@ -220,16 +221,13 @@ static int nvgpu_request_pci_gpios(struct nvgpu_pci_gpios *pgpios)
 	}
 
 	for (i = 0; i < PCI_GPIO_MAX; i++) {
-		gpio = of_get_named_gpio(np, "nvgpu-pci-gpios", i);
-		if (gpio < 0) {
-			ret = gpio;
+		gpio = fwnode_gpiod_get_index(of_fwnode_handle(np),
+				"nvgpu-pci", i, GPIOD_ASIS, "pci-gpio");
+		if (IS_ERR(gpio)) {
+			ret = PTR_ERR(gpio);
 			goto err;
 		}
 
-		ret = gpio_request(gpio, "pci-gpio");
-		if (ret)
-			goto err;
-
 		pgpios->gpios[i] = gpio;
 	}
 
@@ -245,9 +243,9 @@ err:
 
 static int nvgpu_disable_pci_rail(struct nvgpu_pci_gpios *pgpios)
 {
-	int pci_vbat_pwr_on_gpio = pgpios->gpios[PCI_GPIO_VBAT_PWR_ON];
+	struct gpio_desc *pci_vbat_pwr_on_gpio = pgpios->gpios[PCI_GPIO_VBAT_PWR_ON];
 
-	gpio_set_value(pci_vbat_pwr_on_gpio, 0);
+	gpiod_set_raw_value(pci_vbat_pwr_on_gpio, 0);
 
 	mdelay(PCI_VBAR_PWR_OFF_DELAY_MS);
 	return 0;
@@ -255,16 +253,16 @@ static int nvgpu_disable_pci_rail(struct nvgpu_pci_gpios *pgpios)
 
