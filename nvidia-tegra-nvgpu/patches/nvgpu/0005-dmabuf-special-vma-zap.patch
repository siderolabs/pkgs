nvgpu: use the special-VMA range zap API

zap_special_vma_range replaces zap_vma_ptes and retains the range and
special-mapping checks. Keep the existing mmap write lock around it.

diff --git a/drivers/gpu/nvgpu/os/linux/dmabuf_nvs.c b/drivers/gpu/nvgpu/os/linux/dmabuf_nvs.c
--- a/drivers/gpu/nvgpu/os/linux/dmabuf_nvs.c
+++ b/drivers/gpu/nvgpu/os/linux/dmabuf_nvs.c
@@ -48,12 +48,8 @@
 		down_write(&vma->vm_mm->mmap_sem);
 	#endif
 
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 18, 0)
-		zap_vma_ptes(vma, vma->vm_start, vma->vm_end - vma->vm_start);
-#else
-		err = zap_vma_ptes(vma, vma->vm_start,
-				   vma->vm_end - vma->vm_start);
-#endif
+	zap_special_vma_range(vma, vma->vm_start,
+			      vma->vm_end - vma->vm_start);
 
 	#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 8, 0)
 		mmap_write_unlock(vma->vm_mm);

diff --git a/drivers/gpu/nvgpu/os/linux/ioctl_ctrl.c b/drivers/gpu/nvgpu/os/linux/ioctl_ctrl.c
--- a/drivers/gpu/nvgpu/os/linux/ioctl_ctrl.c
+++ b/drivers/gpu/nvgpu/os/linux/ioctl_ctrl.c
@@ -2918,13 +2918,9 @@
 	}
 
 	if (poweroff) {
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 18, 0)
-		zap_vma_ptes(vma, vma->vm_start, vma->vm_end - vma->vm_start);
+		zap_special_vma_range(vma, vma->vm_start,
+				      vma->vm_end - vma->vm_start);
 		err = 0;
-#else
-		err = zap_vma_ptes(vma, vma->vm_start,
-				   vma->vm_end - vma->vm_start);
-#endif
 		if (err == 0) {
 			priv->usermode_vma.vma_mapped = false;
 		} else {
