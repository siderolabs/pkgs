@@ -41,7 +41,8 @@ struct nvs_domain *nvs_domain_create(struct nvs_sched *sched,
 
 	nvs_memset(dom, 0, sizeof(*dom));
 
-	strncpy(dom->name, name, sizeof(dom->name) - 1);
+	memset(dom->name, 0, sizeof(dom->name) - 1);
+	memcpy(dom->name, name, strnlen(name, sizeof(dom->name) - 1));
 	dom->timeslice_ns     = timeslice;
 	dom->preempt_grace_ns = preempt_grace;
 	dom->priv             = priv;

