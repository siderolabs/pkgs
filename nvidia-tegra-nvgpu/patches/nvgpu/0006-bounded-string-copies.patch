nvgpu: replace remaining kernel strncpy calls

Preserve bounded-copy and zero-padding semantics with memset, strnlen
and memcpy. Keep explicit terminators at callers that truncate strings.
The PMU format-prefix copy has a known length and needs no padding.

diff --git a/drivers/gpu/nvgpu/os/linux/os_sched.c b/drivers/gpu/nvgpu/os/linux/os_sched.c
index bafeeae..91524f8 100644
--- a/drivers/gpu/nvgpu/os/linux/os_sched.c
+++ b/drivers/gpu/nvgpu/os/linux/os_sched.c
@@ -36,7 +36,8 @@ void nvgpu_get_thread_name(char *dest)
 	char buf[TASK_COMM_LEN];
 
 	get_task_comm(buf, current);
-	strncpy(dest, buf, TASK_COMM_LEN);
+	memset(dest, 0, TASK_COMM_LEN);
+	memcpy(dest, buf, strnlen(buf, TASK_COMM_LEN));
 	/* Ensure buffer is null terminated */
 	dest[TASK_COMM_LEN-1] = '\0';
 }

